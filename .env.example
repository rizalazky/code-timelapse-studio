# Path to your exported spreadsheet CSV (default: data/animations.csv)
SPREADSHEET_PATH=data/animations.csv

# --- YouTube (Data API v3) ---
# From Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Obtained once via: node scripts/get-youtube-refresh-token.js
YOUTUBE_REFRESH_TOKEN=

# --- TikTok (Content Posting API) ---
# From developers.tiktok.com — an access token with the video.publish scope
# for the target creator account.
TIKTOK_ACCESS_TOKEN=
